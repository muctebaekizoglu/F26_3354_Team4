# Copy to app/.env (optional; sensible defaults are used when missing).
# API port
PORT=4000
# Secret used to sign the session cookie. If unset, a random one is generated at startup
# (sessions then reset on every restart). Use a long random string outside of demos.
SESSION_SECRET=change-me-to-a-long-random-string
# Client: base URL of the REST API. "/api" uses the Vite dev proxy to the API on PORT.
VITE_API_BASE_URL=/api
