@startuml
!include common.iuml
left to right direction
title Use Case Diagram D1 - Authentication
actor Worker
actor Supervisor
actor Admin
rectangle "LOTO Management System" {
  usecase "UC-1 Log In" as UC1
  usecase "Verify Credentials" as VC
  usecase "Lock Account\n(after 5 failed attempts)" as LA
}
Worker -- UC1
Supervisor -- UC1
Admin -- UC1
UC1 ..> VC : <<include>>
LA ..> UC1 : <<extend>>
@enduml
